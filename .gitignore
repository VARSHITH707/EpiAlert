# Secrets — never commit. Contains the session signing key.
.env

# Database. ~184 MB, well over GitHub's 100 MB file limit.
# Rebuilt by `python setup.py`.
*.db
*.db-journal

# Generated dataset. ~370 MB of report files plus ~93 MB consolidated.
# Rebuilt from people.csv + ground_truth.csv by `python generate_dataset.py`.
data/consolidated/
data/EpiAlert_Phase1_Dataset/week_*/

# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Generated during runs, not source
results/consolidation_progress.json
reports/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Contains real phone numbers. Regenerated by setup.py from people.csv with a
