# Copy to .env and adjust. setup.py creates this automatically if absent.
# Write as UTF-8. PowerShell `echo x >> .env` produces UTF-16, which cannot
# be read and will stop the app from starting.

# Signs session cookies. Generate your own:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Without it, a random key is used and everyone is signed out on restart.
EPIALERT_SECRET_KEY=change-me-to-a-long-random-string

DB_TYPE=sqlite
DB_PATH=epialert_demo.db

# mock sends nothing and still writes the audit trail. Leave it on mock
# unless you have a provider configured and intend to send real messages.
SMS_MODE=mock

# Numbers the demo assigns to the synthetic population. These placeholders are
# unreachable on purpose. Put real numbers here only if you own them -- and
# never commit this file.
ALERT_PHONE_NUMBERS=+910000000001,+910000000002,+910000000003
